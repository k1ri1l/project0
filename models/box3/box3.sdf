<?xml version="1.0"?>
<sdf version="1.8">
<model name="box">
      <self_collide>false</self_collide>
      <link name="body">
      <gravity>false</gravity>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.166667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.166667</iyy>
          <iyz>0</iyz>
          <izz>0.166667</izz>
        </inertia>
      </inertial>
        
      <collision name="collision_right">
        <pose>0 0 2.5 0 0 0</pose>
        <geometry><box><size>0.9 0.9 10</size></box></geometry>
      </collision>
      <visual name="visual_right">
        <pose>0 0 2.5 0 0 0</pose>
        <geometry><box><size>1 1 10</size></box></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>
    </link>
    <link name="zahvat">
      <pose>0 0.65 -2.2 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.166667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.166667</iyy>
          <iyz>0</iyz>
          <izz>0.166667</izz>
        </inertia>
      </inertial>
      <collision name="val">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.5</radius><length>0.3</length></cylinder></geometry>
      </collision>
      <visual name="val">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.5</radius><length>0.3</length></cylinder></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>
      <collision name="center">
        <pose>0 0.65 0 0 0 0</pose>
        <geometry><box><size>1 1 5</size></box></geometry>
      </collision>
      <visual name="center">
        <pose>0 0.65 0 0 0 0</pose>
        <geometry><box><size>1 1 5</size></box></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>
      <collision name="zahvat_collision">
        <pose>0 0.65 -3.0 0 0 0</pose>
        <geometry><box><size>0.2 0.2 1</size></box></geometry>
      </collision>
      <visual name="zahvat">
        <pose>0 0.65 -3.0 0 0 0</pose>
        <geometry><box><size>0.2 0.2 1</size></box></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>
       <sensor name="left_finger_contact" type="contact">
         <always_on>true</always_on>
         <update_rate>50.0</update_rate>
         <contact>
            <collision>zahvat_collision</collision>
         </contact>
       </sensor>

       <collision name="lazer">
        <pose>0 0.65 2.6 0 0 0</pose>
        <geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry>
      </collision>
      <visual name="lazer">
        <pose>0 0.65 2.6 0 0 0</pose>
        <geometry><cylinder><radius>0.25</radius><length>0.2</length></cylinder></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>      
    </link>
    <joint name="val_body" type="revolute">
    <parent>body</parent>
    <child>zahvat</child>
    <axis><xyz>0 1 0</xyz>
      <limit>
        
        <effort>1000</effort>
        <velocity>10</velocity>
      </limit>
    </axis>
    </joint>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/cmd_vel_z</topic> 
      </plugin>
      
      <plugin
        filename="gz-sim-joint-position-controller-system"
        name="gz::sim::systems::JointPositionController">
        <joint_name>val_body</joint_name>
        <topic>/cmd_vel_rotate</topic>
        <use_actuator_msg>false</use_actuator_msg> 
        <p_gain>50.0</p_gain>
        <i_gain>1.0</i_gain>
        <d_gain>5.0</d_gain>
        <i_max>10.0</i_max>
        <i_min>-10.0</i_min>
      </plugin>
      <plugin
        filename="libgz-sim-detachable-joint-system.so"
        name="gz::sim::systems::DetachableJoint">
        <parent_link>zahvat</parent_link>
        <child_model>box3</child_model> 
        <child_link>body</child_link>   
        <attach_topic>/gripper/attach</attach_topic>
        <detach_topic>/gripper/detach</detach_topic>
        <output_topic>/gripper/status</output_topic>
        <suppress_child_warning>true</suppress_child_warning> 
      </plugin>
    </model>
</sdf>
