<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="warehouse_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 15 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- ПОЛ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- СТЕНЫ КОМНАТЫ 16x16 м -->
    <model name="wall_n"><static>true</static><pose>0 8 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>16.4 0.2 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>16.4 0.2 1.0</size></box></geometry><material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -8 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>16.4 0.2 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>16.4 0.2 1.0</size></box></geometry><material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>8 0 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 16.0 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 16.0 1.0</size></box></geometry><material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-8 0 0.5 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.2 16.0 1.0</size></box></geometry></collision><visual name="v"><geometry><box><size>0.2 16.0 1.0</size></box></geometry><material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual></link></model>

    <!-- СТАТИЧЕСКИЕ КУБИЧЕСКИЕ ПРЕПЯТСТВИЯ В ЗАЛЕ -->
    <model name="obs_1"><static>true</static><pose>-2.2 2.2 0.4 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 1.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 1.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>
    <model name="obs_2"><static>true</static><pose>-2.2 -2.2 0.4 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 1.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 1.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>
    <model name="obs_3"><static>true</static><pose>-0.5 0.0 0.4 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>1.0 1.0 0.8</size></box></geometry></collision><visual name="v"><geometry><box><size>1.0 1.0 0.8</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual></link></model>

    <!-- СТАНЦИЯ ДОМ (-5.5, 0.0) -->
    <model name="station_home">
      <static>true</static>
      <pose>-5.5 0.0 0.002 0 0 0</pose>
      <link name="l">
        <visual name="v">
          <geometry><box><size>1.6 1.6 0.004</size></box></geometry>
          <material><ambient>0.15 0.75 0.25 1</ambient><diffuse>0.15 0.75 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- КУБ А (5.5, 3.5, ширина 2.2x2.2, высота 0.40) + ПАНДУС А ВРОВЕНЬ ПО ШИРИНЕ (2.2 м) -->
    <model name="cube_a">
      <static>true</static>
      <pose>5.5 3.5 0.20 0 0 0</pose>
      <link name="l">
        <collision name="c">
          <geometry><box><size>2.2 2.2 0.40</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>2.2 2.2 0.40</size></box></geometry>
          <material><ambient>0.2 0.45 0.85 1</ambient><diffuse>0.2 0.45 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ramp_a">
      <static>true</static>
      <pose>3.0 3.5 0.195 0 -0.141897 0</pose>
      <link name="l">
        <collision name="c">
          <geometry><box><size>2.86 2.2 0.02</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>2.86 2.2 0.02</size></box></geometry>
          <material><ambient>0.45 0.5 0.55 1</ambient><diffuse>0.45 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- КУБ Б (5.5, -3.5, ширина 2.2x2.2, высота 0.40) + ПАНДУС Б ВРОВЕНЬ ПО ШИРИНЕ (2.2 м) -->
    <model name="cube_b">
      <static>true</static>
      <pose>5.5 -3.5 0.20 0 0 0</pose>
      <link name="l">
        <collision name="c">
          <geometry><box><size>2.2 2.2 0.40</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>2.2 2.2 0.40</size></box></geometry>
          <material><ambient>0.9 0.5 0.15 1</ambient><diffuse>0.9 0.5 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ramp_b">
      <static>true</static>
      <pose>3.0 -3.5 0.195 0 -0.141897 0</pose>
      <link name="l">
        <collision name="c">
          <geometry><box><size>2.86 2.2 0.02</size></box></geometry>
          <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><box><size>2.86 2.2 0.02</size></box></geometry>
          <material><ambient>0.45 0.5 0.55 1</ambient><diffuse>0.45 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- МАШИНКА SHUTTLE_CAR (шайба лидара прямо на крыше БЕЗ палки, низкий центр тяжести) -->
    <model name="shuttle_car">
      <pose>-5.5 0.0 0.09 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <!-- Сильно заниженный центр масс, чтобы никогда не опрокидывалась -->
          <pose>0 0 -0.04 0 0 0</pose>
          <mass>4.0</mass>
          <inertia>
            <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.08</iyy><iyz>0</iyz>
            <izz>0.10</izz>
          </inertia>
        </inertial>

        <collision name="body_col">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><box><size>0.42 0.28 0.08</size></box></geometry>
        </collision>
        <visual name="body_vis">
          <pose>0 0 0.02 0 0 0</pose>
          <geometry><box><size>0.42 0.28 0.08</size></box></geometry>
          <material><ambient>0.1 0.65 0.75 1</ambient><diffuse>0.1 0.65 0.75 1</diffuse></material>
        </visual>

        <!-- ШАЙБА ЛИДАРА ПРЯМО НА КРЫШЕ КОРПУСА (никаких палок и труб!) -->
        <visual name="lidar_puck_vis">
          <pose>0.04 0 0.075 0 0 0</pose>
          <geometry><cylinder><radius>0.042</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.12 0.12 0.15 1</ambient><diffuse>0.15 0.15 0.18 1</diffuse></material>
        </visual>

        <!-- Сенсор лидара -->
        <sensor name="lidar" type="gpu_lidar">
          <pose>0.04 0 0.22 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>true</visualize>
          <topic>/scan</topic>
          <ray>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range><min>0.22</min><max>12.0</max><resolution>0.01</resolution></range>
          </ray>
        </sensor>

        <!-- IMU -->
        <sensor name="imu_sensor" type="imu">
          <always_on>true</always_on>
          <update_rate>50</update_rate>
          <topic>/imu</topic>
        </sensor>

        <!-- ДАТЧИКИ ОБРЫВА (CLIFF SENSORS) -->
        <sensor name="cliff_front_left" type="gpu_lidar">
          <pose>0.22 0.12 0.0 0 0.55 0</pose>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>/cliff/front_left</topic>
          <ray>
            <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
            <range><min>0.02</min><max>2.0</max><resolution>0.005</resolution></range>
          </ray>
        </sensor>

        <sensor name="cliff_front_right" type="gpu_lidar">
          <pose>0.22 -0.12 0.0 0 0.55 0</pose>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
          <topic>/cliff/front_right</topic>
          <ray>
            <scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
            <range><min>0.02</min><max>2.0</max><resolution>0.005</resolution></range>
          </ray>
        </sensor>
      </link>

      <!-- 4 ШИРОКО ПОСТАВЛЕННЫХ КОЛЕСА (высокая устойчивость) -->
      <link name="wheel_fl">
        <pose>0.13 0.17 -0.02 -1.570796 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0005</iyy><iyz>0</iyz><izz>0.0008</izz></inertia></inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <joint name="wheel_fl_joint" type="revolute">
        <parent>base_link</parent><child>wheel_fl</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>

      <link name="wheel_fr">
        <pose>0.13 -0.17 -0.02 -1.570796 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0005</iyy><iyz>0</iyz><izz>0.0008</izz></inertia></inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <joint name="wheel_fr_joint" type="revolute">
        <parent>base_link</parent><child>wheel_fr</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>

      <link name="wheel_rl">
        <pose>-0.13 0.17 -0.02 -1.570796 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0005</iyy><iyz>0</iyz><izz>0.0008</izz></inertia></inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <joint name="wheel_rl_joint" type="revolute">
        <parent>base_link</parent><child>wheel_rl</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>

      <link name="wheel_rr">
        <pose>-0.13 -0.17 -0.02 -1.570796 0 0</pose>
        <inertial><mass>0.3</mass><inertia><ixx>0.0005</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0005</iyy><iyz>0</iyz><izz>0.0008</izz></inertia></inertial>
        <collision name="c">
          <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
          <surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface>
        </collision>
        <visual name="v">
          <geometry><cylinder><radius>0.07</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <joint name="wheel_rr_joint" type="revolute">
        <parent>base_link</parent><child>wheel_rr</child>
        <axis><xyz expressed_in="__model__">0 1 0</xyz></axis>
      </joint>

      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>wheel_fl_joint</left_joint>
        <left_joint>wheel_rl_joint</left_joint>
        <right_joint>wheel_fr_joint</right_joint>
        <right_joint>wheel_rr_joint</right_joint>
        <wheel_separation>0.34</wheel_separation>
        <wheel_radius>0.07</wheel_radius>
        <max_linear_acceleration>3.0</max_linear_acceleration>
        <max_angular_acceleration>5.0</max_angular_acceleration>
        <topic>/cmd_vel</topic>
      </plugin>

      <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>30</odom_publish_frequency>
        <odom_topic>/odom</odom_topic>
        <dimensions>3</dimensions>
      </plugin>
    </model>
  </world>
</sdf>
