<?xml version="1.0"?>
<sdf version="1.10">
  <world name="camera_dancer_world">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.78 0.85 0.93 1</background>
      <shadows>true</shadows>
    </scene>
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.6 0.6 0.6</ambient_light>
        <background_color>0.78 0.85 0.93</background_color>
        <camera_pose>-5 -5 4 0 0.46 0.7854</camera_pose>
      </plugin>
      <plugin filename="SelectEntities" name="Выбор объектов">
        <gz-gui>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="View Control">
        <gz-gui>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="LiveTransformControl" name="Перемещение объекта">
        <gz-gui>
          <title>Переместить / повернуть объект</title>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="top" target="top"/>
          </anchors>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">230</property>
          <property type="double" key="height">50</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World Control">
        <gz-gui>
          <title>World Control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World Stats">
        <gz-gui>
          <title>World Stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">100</property>
          <property type="double" key="width">250</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time_factor>true</real_time_factor>
      </plugin>
      <plugin filename="ImageDisplay" name="ArUco: изображение и ID">
        <gz-gui>
          <title>Камера — ArUco ID 23</title>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">true</property>
          <property type="double" key="width">640</property>
          <property type="double" key="height">500</property>
          <property type="double" key="x">540</property>
          <property type="double" key="y">60</property>
        </gz-gui>
        <topic>/aruco_camera/annotated</topic>
        <topic_picker>false</topic_picker>
      </plugin>
    </gui>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>2000 2000</size></plane></geometry>
          <surface><friction><ode><mu>0</mu><mu2>0</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>2000 2000</size></plane></geometry>
          <material><ambient>0.65 0.69 0.73 1</ambient><diffuse>0.65 0.69 0.73 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="static_camera">
      <!-- Camera body is horizontal and its lens faces +X. -->
      <static>true</static>
      <pose>0 0 1.4 0 0 0</pose>
      <link name="camera_body">
        <visual name="cylinder_body">
          <pose>0 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.075</radius><length>0.42</length></cylinder></geometry>
          <material><ambient>0.12 0.16 0.22 1</ambient><diffuse>0.12 0.16 0.22 1</diffuse><specular>0.3 0.3 0.3 1</specular></material>
        </visual>
        <visual name="camera_lens">
          <pose>0.216 0 0 0 1.5708 0</pose>
          <geometry><cylinder><radius>0.052</radius><length>0.012</length></cylinder></geometry>
          <material><ambient>0.02 0.08 0.12 1</ambient><diffuse>0.02 0.08 0.12 1</diffuse></material>
        </visual>
        <sensor name="front_camera" type="camera">
          <pose>0.23 0 0 0 0.1 0</pose>
          <topic>/front_camera/image</topic>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.03</near><far>100</far></clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <visualize>true</visualize>
        </sensor>
      </link>
    </model>

    <include>
      <uri>model://aruco_marker</uri>
      <name>aruco_marker_id_23</name>
      <!-- Vertical board, facing the camera along -X, at optical-center height. -->
      <pose>3.5 0 1.05 0 -1.5708 0</pose>
    </include>
  </world>
</sdf>
